{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shaowuz/intentional-agent/schemas/visualization-v4",
  "title": "Intentional Agent visualization bundle v4",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "intentional-agent.visualization/4"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "incomplete"
      ]
    },
    "tables": {
      "type": "object",
      "properties": {
        "episodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/episodes"
          }
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cells"
          }
        },
        "contrasts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contrasts"
          }
        },
        "status": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/status"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/actions"
          }
        },
        "beliefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/beliefs"
          }
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/messages"
          }
        },
        "elections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/elections"
          }
        },
        "leader_assignments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/leader_assignments"
          }
        },
        "usage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/usage"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/events"
          }
        }
      },
      "required": [
        "episodes",
        "cells",
        "contrasts",
        "status",
        "actions",
        "beliefs",
        "messages",
        "elections",
        "leader_assignments",
        "usage",
        "events"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "snapshot_id",
    "status",
    "tables"
  ],
  "additionalProperties": false,
  "$defs": {
    "episodes": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "episode_id": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "communication": {
          "type": "string",
          "enum": [
            "none",
            "public",
            "opponent",
            "good_leader",
            "selfish_leader",
            "leader"
          ]
        },
        "selfish_count": {
          "type": "integer",
          "enum": [
            0,
            1,
            3,
            5
          ]
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "backend": {
          "type": "string",
          "enum": [
            "openrouter",
            "scripted"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "not_started",
            "incomplete",
            "complete"
          ]
        },
        "protocol_version": {
          "type": "string",
          "minLength": 1
        },
        "belief_format": {
          "type": "string",
          "enum": [
            "categorical",
            "marginal"
          ]
        },
        "players": {
          "type": "integer",
          "minimum": 1
        },
        "rounds": {
          "type": "integer",
          "minimum": 1
        },
        "reasoning_effort": {
          "type": "string",
          "minLength": 1
        },
        "selfish_persona": {
          "type": "string",
          "minLength": 1
        },
        "good_total_return": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Total payoff points of all actual good players; null until complete."
        },
        "return_per_good_encounter": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 5,
          "description": "Good total return / (rounds × number of good players)."
        },
        "good_good_return": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "good_selfish_return": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "good_cooperation_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "all_cooperation_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "mean_brier_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 2.000002,
          "description": "Marginal: mean binary error over other players, then good-agent reports. Legacy categorical: summed category error."
        },
        "final_mean_brier_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 2.000002,
          "description": "Same Brier definition using final good-agent reports only."
        },
        "final_identification_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1,
          "description": "Fraction of good-agent/selfish-target pairs with final probability >= 0.8; null with no selfish players."
        },
        "final_correct_none_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "false_accusation_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "leader_is_selfish": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "True/false for a predetermined or legacy elected leader; null if no leader or episode incomplete."
        },
        "pre_midpoint_return_per_good_encounter": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 5
        },
        "post_midpoint_return_per_good_encounter": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 5
        },
        "leader": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "selfish_players": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "completed_model_responses": {
          "type": "integer",
          "minimum": 0
        },
        "prompt_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "completion_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "reported_cost_usd": {
          "type": "number",
          "minimum": 0,
          "description": "Sum of known reported costs in USD; may be incomplete."
        },
        "responses_missing_cost": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "run_id",
        "episode_id",
        "model",
        "communication",
        "selfish_count",
        "seed",
        "backend",
        "status",
        "protocol_version",
        "belief_format",
        "players",
        "rounds",
        "reasoning_effort",
        "selfish_persona",
        "good_total_return",
        "return_per_good_encounter",
        "good_good_return",
        "good_selfish_return",
        "good_cooperation_rate",
        "all_cooperation_rate",
        "mean_brier_score",
        "final_mean_brier_score",
        "final_identification_rate",
        "final_correct_none_rate",
        "false_accusation_rate",
        "leader_is_selfish",
        "pre_midpoint_return_per_good_encounter",
        "post_midpoint_return_per_good_encounter",
        "leader",
        "selfish_players",
        "completed_model_responses",
        "prompt_tokens",
        "completion_tokens",
        "reported_cost_usd",
        "responses_missing_cost"
      ],
      "additionalProperties": false,
      "x-primary-key": [
        "run_id",
        "episode_id"
      ],
      "description": "One row for every planned episode. Metrics are null until complete."
    },
    "cells": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
