      "required": [
        "run_id",
        "kind",
        "contrast",
        "baseline_value",
        "comparison_value",
        "model",
        "communication",
        "selfish_count",
        "matched_seeds",
        "seed_ids",
        "mean_total_return_difference",
        "mean_normalized_difference",
        "normalized_ci_lower",
        "normalized_ci_upper"
      ],
      "additionalProperties": false,
      "x-primary-key": [
        "run_id",
        "kind",
        "baseline_value",
        "comparison_value",
        "model",
        "communication",
        "selfish_count"
      ],
      "description": "One planned contrast; difference = comparison minus baseline. CI bounds are null with fewer than two matched seeds."
    },
    "status": {
      "type": "object",
      "properties": {
