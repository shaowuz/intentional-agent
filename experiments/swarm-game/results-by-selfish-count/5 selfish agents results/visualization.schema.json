          ],
          "minimum": 0,
          "maximum": 2.000002,
          "description": "Marginal: mean binary error over other players, then good-agent reports. Legacy categorical: summed category error."
        },
        "final_mean_brier_score": {
          "type": [
            "number",
            "null"
          ],
