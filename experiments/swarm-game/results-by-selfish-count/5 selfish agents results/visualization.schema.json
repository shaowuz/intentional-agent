        "false_accusation_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "selfish_leader_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "pre_midpoint_return_per_good_encounter": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 5
        },
        "post_midpoint_return_per_good_encounter": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 5
        }
      },
      "required": [
        "run_id",
        "model",
        "communication",
        "selfish_count",
        "completed_episodes",
        "planned_episodes",
        "good_total_return",
        "return_per_good_encounter",
        "good_good_return",
        "good_selfish_return",
        "good_cooperation_rate",
        "all_cooperation_rate",
        "mean_brier_score",
        "final_mean_brier_score",
        "final_identification_rate",
        "final_correct_none_rate",
        "false_accusation_rate",
        "selfish_leader_rate",
        "pre_midpoint_return_per_good_encounter",
        "post_midpoint_return_per_good_encounter"
      ],
      "additionalProperties": false,
      "x-primary-key": [
        "run_id",
        "model",
        "communication",
        "selfish_count"
      ],
      "description": "One row per planned model/communication/role cell; means use completed episodes only."
    },
    "contrasts": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "type": "string",
          "enum": [
            "model",
            "communication"
          ]
        },
        "contrast": {
          "type": "string",
          "minLength": 1
        },
        "baseline_value": {
          "type": "string",
          "minLength": 1
        },
        "comparison_value": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "communication": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "none",
            "public",
            "opponent",
            "good_leader",
            "selfish_leader",
            "leader",
            null
          ]
        },
        "selfish_count": {
          "type": "integer",
          "enum": [
            0,
            1,
            3,
            5
          ]
        },
        "matched_seeds": {
          "type": "integer",
          "minimum": 0
        },
        "seed_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true
        },
        "mean_total_return_difference": {
          "type": [
            "number",
            "null"
          ]
        },
        "mean_normalized_difference": {
          "type": [
            "number",
            "null"
          ]
