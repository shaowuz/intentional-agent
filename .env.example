# Optional settings. This file is not loaded automatically.
# Export these variables in your shell before running ./scripts/dev.sh.
# Do not place API keys in this file; configure them through API Settings.

# Defaults to the repository's .data directory when unset.
# IA_DATA_DIR=/absolute/path/to/private-experiment-data

# Disable new local registrations after creating the desired accounts.
IA_ALLOW_REGISTRATION=true

# A trusted image already present in the local Docker image cache.
# INTENTIONAL_AGENT_SANDBOX_IMAGE=python:3.12-slim
